@model VNS.ThreeCStats.Web.Controllers.PlayerDetailViewModel
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>
<p>Country: @Model.CountryCode</p>
<p>Matches: @Model.Matches.Count</p>

<table>
    <thead>
        <tr>
            <th>Date</th>
            <th>Tournament</th>
            <th>Stage</th>
            <th>Group</th>
            <th>Player 1</th>
            <th>Score</th>
            <th>Player 2</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var matchItem in Model.Matches)
    {
        <tr>
            <td>@matchItem.PlayedAt</td>
            <td>@matchItem.TournamentName</td>
            <td>@matchItem.Stage</td>
            <td>@matchItem.Group</td>
            <td>
                <a href="/players/@matchItem.Player1Id">@matchItem.Player1Name</a>
            </td>
            <td>
                @matchItem.Player1Score - @matchItem.Player2Score
            </td>
            <td>
                <a href="/players/@matchItem.Player2Id">@matchItem.Player2Name</a>
            </td>
        </tr>
    }
    </tbody>
</table>
